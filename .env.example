# ---------------------------------------------------------------------------
# Softworg Engineering Services: environment configuration
# Copy to .env.local for development. Never commit real values (.env* is git-ignored except this file).
# Public business facts (name, email, phone, address, social links) are NOT configured here:
# they live in src/shared/config/site.ts.
# ---------------------------------------------------------------------------

# Public website origin, e.g. https://example.org (server-side only).
# NOT YET CONFIGURED for production: the real domain has not been decided.
# While unset in production, canonical URLs, Open Graph URLs, the sitemap and structured-data URLs are
# omitted rather than guessed. In development it defaults to http://localhost:3000.
# Set it at BUILD time once the domain exists.
# SITE_URL=

# Contact delivery. All variables below are server-only; never prefix them with NEXT_PUBLIC_.
# The form is disabled unless FEATURE_CONTACT_FORM is exactly true.
FEATURE_CONTACT_FORM=false
CONTACT_DELIVERY_MODE=disabled

# Enable test mode only for local/non-production testing. The log receiver discards the enquiry content.
# CONTACT_DELIVERY_MODE=test

# Live mode requires all settings below plus NODE_ENV=production and CONTACT_DEPLOYMENT_ENV=production.
# Configure CONTACT_DEPLOYMENT_ENV=production only in the approved production runtime, never in previews.
# If the platform provides VERCEL_ENV, it must also be production.
# Keep live disabled until the owner confirms production context, sender/domain verification and recipients.
# CONTACT_DELIVERY_MODE=live
# CONTACT_DEPLOYMENT_ENV=production
# RESEND_API_KEY=re_...
# CONTACT_FROM_EMAIL=enquiries@your-verified-domain.example
# Set true only after verifying the exact sender domain/address in the Resend dashboard.
# CONTACT_SENDER_DOMAIN_VERIFIED=true
# CONTACT_NOTIFICATION_RECIPIENTS=first@your-domain.example,second@your-domain.example
# Generate a unique random secret with at least 32 bytes of entropy for this environment.
# CONTACT_SIGNING_SECRET=

# Do not put real values in this file. Set credentials in the server runtime's secret configuration.
